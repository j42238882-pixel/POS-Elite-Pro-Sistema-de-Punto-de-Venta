{
  "name": "pos-elite",
  "version": "1.0.0",
  "description": "Sistema de Punto de Venta profesional con soporte dual moneda USD/VES",
  "main": "main.js",
  "scripts": {
    "start": "node dist-server/server/index.js",
    "server": "node dist-server/server/index.js",
    "server:dev": "ts-node src/server/index.ts",
    "build:ts": "tsc",
    "build:css": "npx @tailwindcss/cli -i tailwind/input.css -o css/tailwind.output.css",
    "build": "npm run build:ts && npm run build:css",
    "typecheck": "tsc --noEmit",
    "electron:start": "electron .",
    "electron:build": "electron-builder --win"
  },
  "build": {
    "appId": "com.pos.elite",
    "productName": "POS Elite Pro",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.6.5",
    "autoprefixer": "^10.6.1",
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "pos",
    "punto-de-venta",
    "electron",
    "venezuela",
    "facturacion"
  ],
  "author": "",
  "license": "ISC",
  "allowScripts": {
    "electron@29.4.6": true
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "cors": "^2.8.6",
    "express": "^5.3.0"
  }
}
